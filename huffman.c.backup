void encode(const char *src, char *dst) {
  int weights[256];
  memset(weights, 0, sizeof(weights));
  for (int i = 0; i < strlen(src); i++) {
    weights[(unsigned char)src[i]]++;
  }
  int available_count = 0, char_cursor = 0;
  int cut_weights[256];
  char chars[256];
  memset(cut_weights, 0, sizeof(cut_weights));
  memset(chars, 0, sizeof(chars));
  for (int j = 0; j < 256; j++) {
    if (weights[j] > 0) {
      chars[available_count] = j;
      cut_weights[available_count] = weights[j];
      available_count++;
    }
  }
  huffman_tree *tree;
  build_tree(cut_weights, tree, available_count);
  for (int a = 0; a < strlen(src); a++) {
    huffman_node *node = (*tree);
  }
}
